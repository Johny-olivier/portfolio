{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "johny-portfolio-assistant",
  "main": "index.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGINS": "https://johny-olivier.github.io,http://127.0.0.1:4173",
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "2026091001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
